# ─────────────────────────────────────────────────────────────────────────────
# FAULTLINE — environment template.  Copy to `.env` and fill in.  NEVER commit `.env`.
# The private key below is read into memory by the deploy script only. It is never
# printed, logged, or written anywhere else by any tool in this repo.
# ─────────────────────────────────────────────────────────────────────────────

# GenLayer Bradbury testnet (chain 4221)
GENLAYER_RPC_URL=https://rpc-bradbury.genlayer.com
GENLAYER_NETWORK=testnet-bradbury
GENLAYER_CHAIN_ID=4221

# Your funded Bradbury account private key (hex, 0x-prefixed, 64 hex chars).
# Fund it first at https://testnet-faucet.genlayer.foundation/ (100 GEN / 24h).
# Paste your key into `.env` only — it must never appear in chat, logs, or git.
ACCOUNT_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Address of the contract after deployment (filled in once deployed).
FAULTLINE_CONTRACT_ADDRESS=

# ── Frontend (web/app) — Vite exposes only VITE_* vars to the browser bundle ──
# Privy app ID for connect-wallet. This is a PUBLIC client identifier (safe to
# ship in the frontend, like a GA ID) — it is NOT a secret. Get it from the
# Privy dashboard. The wallet private key above is NEVER sent to the browser.
VITE_PRIVY_APP_ID=
# Contract address the web app reads/writes (defaults to the deployed v0.6.0).
VITE_FAULTLINE_ADDRESS=
